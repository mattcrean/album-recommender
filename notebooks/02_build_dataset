   "source": [
    "# Build Modelling Dataset\n",
    "\n",
    "This notebook turns the validated ListenBrainz data into a clean interaction dataset that is ready for recommendation modelling and SQL querying."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "978335ff",
   "metadata": {},
   "source": [
    "## 1. Load and aggregate the full dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "de43a911",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from collections import Counter\n",
    "from pathlib import Path\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "pd.set_option(\"display.max_columns\", None)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9f3fd888",
   "metadata": {},
   "outputs": [],
   "source": [
    "listens_path = Path(\"..\") / \"..\" / \"data\" / \"2026\" / \"7.listens\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "6839bbb1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Processed 500,000 listens\n",
      "Processed 1,000,000 listens\n",
      "Processed 1,500,000 listens\n",
      "Processed 2,000,000 listens\n",
      "Processed 2,500,000 listens\n",
      "Processed 3,000,000 listens\n",
      "Processed 3,500,000 listens\n",
      "Processed 4,000,000 listens\n",
      "Processed 4,500,000 listens\n"
     ]
    }
   ],
   "source": [
    "user_album_counts = Counter()\n",
    "\n",
    "valid_listens = 0\n",
    "\n",
    "with listens_path.open(\"r\", encoding=\"utf-8\") as listens_file:\n",
    "\n",
    "    for line_number, line in enumerate(listens_file, start=1):\n",
    "\n",
    "        record = json.loads(line)\n",
    "\n",
    "        user_id = record.get(\"user_id\")\n",
    "\n",
    "        track_metadata = record.get(\"track_metadata\", {})\n",
    "        artist_name = track_metadata.get(\"artist_name\")\n",
    "        release_name = track_metadata.get(\"release_name\")\n",
    "\n",
    "        # Ignore listens where we cannot identify an album\n",
    "        if user_id is None or not artist_name or not release_name:\n",
    "            continue\n",
    "\n",
    "        # Temporary album identifier\n",
    "        album_identifier = (\n",
    "            artist_name.strip().lower(),\n",
    "            release_name.strip().lower()\n",
    "        )\n",
    "\n",
    "        user_album_counts[(user_id, album_identifier)] += 1\n",
    "        valid_listens += 1\n",
    "\n",
    "        # Optional progress update\n",
    "        if line_number % 500_000 == 0:\n",
    "            print(f\"Processed {line_number:,} listens\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "508320c9",
   "metadata": {},
   "source": [
